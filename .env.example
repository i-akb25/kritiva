# Set this to the final production origin before deployment.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional AI gateway. Local tools work without these values.
# Contract: POST {URL}/generate and GET {URL}/jobs/:id with Bearer authentication.
KRITIVA_AI_MODE=gateway
KRITIVA_AI_PROVIDER_NAME=
KRITIVA_AI_PROVIDER_URL=
KRITIVA_AI_API_KEY=
KRITIVA_AI_RETENTION=
KRITIVA_AI_TRAINING_POLICY=

# Personal NVIDIA prototype mode. Text-to-3D only; trial access is not production infrastructure.
# KRITIVA_AI_MODE=nvidia-prototype
# NVIDIA_API_KEY=

# Personal local-compute mode. Profiles: auto, nvidia-rtx, apple-silicon, intel-cpu, amd-cpu.
# KRITIVA_AI_MODE=local-compute
# KRITIVA_LOCAL_PROFILE=auto
# KRITIVA_LOCAL_CONNECTOR_URL=http://127.0.0.1:8787
# KRITIVA_LOCAL_CONNECTOR_TOKEN=
