# Generate a long random value. Never commit the real token.
KRITIVA_RTX_CONNECTOR_TOKEN=replace-with-a-long-random-token
# auto, nvidia-nim, sf3d-cuda, sf3d-mps, or sf3d-cpu
KRITIVA_LOCAL_ENGINE=auto
TRELLIS_NIM_URL=http://127.0.0.1:8000/v1/infer
SF3D_REPO_PATH=/absolute/path/to/stable-fast-3d
KRITIVA_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
